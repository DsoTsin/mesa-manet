OpCapability Shader
OpCapability Int8
OpCapability VulkanMemoryModel
OpCapability GraphARM
OpCapability TensorsARM
OpExtension "SPV_ARM_graph"
OpExtension "SPV_ARM_tensors"
%tosa = OpExtInstImport "TOSA.001000.1"
OpMemoryModel Logical Vulkan
OpDecorate %v0 DescriptorSet 0
OpDecorate %v0 Binding 0
OpDecorate %v1 DescriptorSet 0
OpDecorate %v1 Binding 1
OpDecorate %v2 DescriptorSet 0
OpDecorate %v2 Binding 2
%u = OpTypeInt 32 0
%f = OpTypeInt 8 1
%o = OpTypeInt 32 1
%c0 = OpConstant %u 0
%c1 = OpConstant %u 1
%c2 = OpConstant %u 2
%c3 = OpConstant %u 3
%c4 = OpConstant %u 4
%c5 = OpConstant %u 5
%f0 = OpConstant %f 0
%f1 = OpConstant %f 1
%shape = OpTypeArray %u %c3
%batch = OpConstant %u 2
%rows = OpConstant %u 3
%inner = OpConstant %u 5
%columns = OpConstant %u 4
%s0 = OpConstantComposite %shape %batch %rows %inner
%t0 = OpTypeTensorARM %f %c3 %s0
%p0 = OpTypePointer UniformConstant %t0
%v0 = OpVariable %p0 UniformConstant
%s1 = OpConstantComposite %shape %batch %inner %columns
%t1 = OpTypeTensorARM %f %c3 %s1
%p1 = OpTypePointer UniformConstant %t1
%v1 = OpVariable %p1 UniformConstant
%s2 = OpConstantComposite %shape %batch %rows %columns
%t2 = OpTypeTensorARM %o %c3 %s2
%p2 = OpTypePointer UniformConstant %t2
%v2 = OpVariable %p2 UniformConstant
%array1 = OpTypeArray %u %c1
%s1c = OpConstantComposite %array1 %c1
%tc = OpTypeTensorARM %f %c1 %s1c
%azp = OpConstant %f 3
%bzp = OpConstant %f -2
%zero_a = OpConstantComposite %tc %azp
%zero_b = OpConstantComposite %tc %bzp
%gt = OpTypeGraphARM 2 %t0 %t1 %t2
OpGraphEntryPointARM %graph "main" %v0 %v1 %v2
%graph = OpGraphARM %gt
%a = OpGraphInputARM %t0 %c0
%b = OpGraphInputARM %t1 %c1
%sum = OpExtInst %t2 %tosa MATMUL %a %b %zero_a %zero_b
OpGraphSetOutputARM %sum %c0
OpGraphEndARM
